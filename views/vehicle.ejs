<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= ui.vehicle %> - TSM Stock Photos</title>
    <style>
        :root {
            --bg-color: #f4f4f9;
            --card-bg: #ffffff;
            --text-color: #333333;
            --primary-color: #e53935;
            --border-color: #dddddd;
        }
        .dark-theme {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --text-color: #e0e0e0;
            --primary-color: #ef5350;
            --border-color: #333333;
        }
        body {
            font-family: Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            text-align: center;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
        }
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .back-btn, .theme-btn {
            background: none;
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 8px 15px;
            border-radius: 5px;
            text-decoration: none;
            cursor: pointer;
        }
        h2 {
            margin: 5px 0;
        }
        .badge-container {
            margin-bottom: 15px;
        }
        .badge {
            display: inline-block;
            background: rgba(229, 57, 53, 0.1);
            color: var(--primary-color);
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: bold;
            margin: 0 5px;
        }
        .carousel-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }
        .image-container {
            width: 100%;
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #000;
        }
        .image-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
            background-color: var(--card-bg);
            border-top: 1px solid var(--border-color);
        }
        .action-btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
        }
        .action-btn:hover {
            opacity: 0.9;
        }
        .bulk-download {
            display: block;
            background-color: #2e7d32;
            color: white;
            padding: 12px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="top-bar">
            <a href="/" class="back-btn">⬅ Back to Search</a>
            <button class="theme-btn" onclick="toggleTheme()">🌓 Theme</button>
        </div>

        <h2><%= ui.vehicle %></h2>
        <div class="badge-container">
            <span class="badge">🎨 <%= ui.color %></span>
            <span class="badge">📋 <%= ui.reg %></span>
        </div>

        <% if (images && images.length > 0) { %>
            <a href="<%= images[0] %>" target="_blank" class="bulk-download">📥 Open Full Image Gallery in Google Drive</a>

            <div class="carousel-card">
                <div class="image-container">
                    <img id="active-image" src="<%= images[0] %>" alt="Vehicle Photo">
                </div>
                <div class="card-footer">
                    <span id="counter">Photo 1 of <%= images.length %></span>
                    <% if (images.length > 1) { %>
                        <button class="action-btn" onclick="nextImage()">Next Photo ➡</button>
                    <% } %>
                    <a id="save-btn" href="<%= images[0] %>" target="_blank" download class="action-btn" style="background-color: #2e7d32;">Save Photo</a>
                </div>
            </div>
        <% } else { %>
            <p style="padding: 40px; color: #777;">No photos found for this vehicle folder.</p>
        <% } %>
    </div>

    <script>
        const images = <%- JSON.stringify(images || []) %>;
        let currentIndex = 0;

        function nextImage() {
            if (images.length === 0) return;
            currentIndex = (currentIndex + 1) % images.length;
            document.getElementById('active-image').src = images[currentIndex];
            document.getElementById('counter').innerText = `Photo ${currentIndex + 1} of ${images.length}`;
            document.getElementById('save-btn').href = images[currentIndex];
        }

        function toggleTheme() {
            document.body.classList.toggle('dark-theme');
            localStorage.setItem('theme', document.body.classList.contains('dark-theme') ? 'dark' : 'light');
        }
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-theme');
        }
    </script>
</body>
</html>