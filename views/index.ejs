<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TSM Stock Finder</title>
    <style>
        :root {
            --bg-color: #f4f4f9;
            --card-bg: #ffffff;
            --text-color: #333333;
            --primary-color: #e53935;
            --border-color: #dddddd;
        .dark-theme {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --text-color: #e0e0e0;
            --primary-color: #ef5350;
            --border-color: #333333;
        }
        body {
            font-family: Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            transition: background-color 0.3s, color 0.3s;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 800px;
            margin: 0 auto 20px auto;
        }
        h1 {
            margin: 0;
            color: var(--primary-color);
        }
        .theme-btn {
            background: none;
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 8px 12px;
            border-radius: 5px;
            cursor: pointer;
        }
        .search-container {
            max-width: 800px;
            margin: 0 auto 30px auto;
            display: flex;
            gap: 10px;
        }
        input[type="text"] {
            flex: 1;
            padding: 12px 15px;
            font-size: 16px;
            border: 1px solid var(--border-color);
            border-radius: 5px;
            background-color: var(--card-bg);
            color: var(--text-color);
        }
        button[type="submit"] {
            padding: 12px 25px;
            font-size: 16px;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .results-container {
            max-width: 800px;
            margin: 0 auto;
        }
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .vehicle-info h3 {
            margin: 0 0 5px 0;
        }
        .vehicle-info p {
            margin: 0;
            color: #777;
            font-size: 14px;
        }
        .btn-view {
            background-color: var(--primary-color);
            color: white;
            padding: 8px 15px;
            text-decoration: none;
            border-radius: 5px;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div class="header-container">
        <h1>🚗 TSM Stock Finder</h1>
        <button class="theme-btn" onclick="toggleTheme()">🌓 Theme</button>
    </div>

    <div class="search-container">
        <form action="/search" method="POST" style="display: flex; width: 100%; gap: 10px;">
            <input type="text" name="query" value="<%= query || '' %>" placeholder="Type vehicle model (e.g., Polo, Caddy, Ranger)..." required autocomplete="off">
            <button type="submit">Search</button>
        </form>
    </div>

    <div class="results-container">
        <% if (matches !== null) { %>
            <% if (matches.length === 0) { %>
                <p style="text-align: center; color: #777;">No vehicles found matching "<%= query %>".</p>
            <% } else { %>
                <p style="margin-bottom: 15px; font-weight: bold;">Found <%= matches.length %> result(s):</p>
                <% matches.forEach(match => { %>
                    <div class="card">
                        <div class="vehicle-info">
                            <h3><%= match.ui.vehicle %> (<%= match.brand %>)</h3>
                            <p>Color: <%= match.ui.color %> | Reg: <%= match.ui.reg %></p>
                        </div>
                        <a href="/vehicle?brand=<%= encodeURIComponent(match.brand) %>&folder=<%= encodeURIComponent(match.folderName) %>&id=<%= match.folderId %>" class="btn-view">View Photos</a>
                    </div>
                <% }) %>
            <% } %>
        <% } %>
    </div>

    <script>
        function toggleTheme() {
            document.body.classList.toggle('dark-theme');
            localStorage.setItem('theme', document.body.classList.contains('dark-theme') ? 'dark' : 'light');
        }
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-theme');
        }
    </script>
</body>
</html>