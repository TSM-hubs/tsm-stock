<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TSM Stock Finder</title>
    <style>
        :root {
            --bg: #f4f6f9;
            --surface: #ffffff;
            --text: #2c3e50;
            --text-secondary: #7f8c8d;
            --primary: #e74c3c;
            --card-border: #e1e8ed;
            --input-bg: #ffffff;
            --badge-bg: #ecf0f1;
        }
        [data-theme="dark"] {
            --bg: #121212;
            --surface: #1e1e1e;
            --text: #e0e0e0;
            --text-secondary: #a0a0a0;
            --primary: #bb86fc;
            --card-border: #333333;
            --input-bg: #2c2c2c;
            --badge-bg: #2a2a2a;
        }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); color: var(--text); padding: 20px; margin: 0; transition: background 0.3s, color 0.3s; }
        .container { max-width: 600px; margin: auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        h1 { font-size: 22px; color: var(--primary); margin: 0; font-weight: 600; }
        .theme-btn { background: var(--surface); border: 1px solid var(--card-border); color: var(--text); padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; }
        
        form { display: flex; gap: 10px; margin-bottom: 25px; background: var(--surface); padding: 8px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid var(--card-border); }
        input { flex: 1; padding: 12px 14px; font-size: 16px; border-radius: 8px; border: none; background: var(--input-bg); color: var(--text); outline: none; }
        button[type="submit"] { padding: 0 20px; font-size: 16px; background: var(--primary); color: #fff; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }
        
        .card { background: var(--surface); padding: 16px; border-radius: 12px; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 8px rgba(0,0,0,0.04); border: 1px solid var(--card-border); border-left: 5px solid var(--primary); }
        .card-info h3 { margin: 0 0 8px 0; font-size: 16px; color: var(--text); }
        .details-row { display: flex; gap: 8px; font-size: 13px; flex-wrap: wrap; }
        .badge { background: var(--badge-bg); padding: 4px 8px; border-radius: 6px; color: var(--text-secondary); font-weight: 600; }
        
        .btn-view { background: var(--primary); color: #fff; padding: 10px 14px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 13px; white-space: nowrap; }
    </style>
</head>
<body data-theme="light">
    <div class="container">
        <div class="header">
            <h1>🚗 TSM Stock Finder</h1>
            <button class="theme-btn" onclick="toggleTheme()">🌓 Theme</button>
        </div>

        <form action="/search" method="POST">
            <input type="text" name="query" value="<%= query %>" placeholder="Type vehicle model (e.g. Polo, Caddy)..." required autocomplete="off">
            <button type="submit">Search</button>
        </form>

        <% if (matches !== null) { %>
            <% if (matches.length === 0) { %>
                <p style="text-align: center; color: var(--text-secondary);">No vehicles found for "<%= query %>".</p>
            <% } else { %>
                <p style="color: var(--text-secondary); font-size: 13px; margin-bottom: 12px;">Found <%= matches.length %> match(es):</p>
                <% matches.forEach((item) => { %>
                    <div class="card">
                        <div class="card-info">
                            <h3><%= item.ui.vehicle %></h3>
                            <div class="details-row">
                                <span class="badge">🎨 <%= item.ui.color %></span>
                                <span class="badge">📋 <%= item.ui.reg %></span>
                            </div>
                        </div>
                        <a class="btn-view" href="/vehicle?brand=<%= encodeURIComponent(item.brand) %>&folder=<%= encodeURIComponent(item.folderName) %>">View Photos</a>
                    </div>
                <% }) %>
            <% } %>
        <% } %>
    </div>

    <script>
        const savedTheme = localStorage.getItem('tsm_theme') || 'light';
        document.body.setAttribute('data-theme', savedTheme);

        function toggleTheme() {
            const current = document.body.getAttribute('data-theme');
            const next = current === 'light' ? 'dark' : 'light';
            document.body.setAttribute('data-theme', next);
            localStorage.setItem('tsm_theme', next);
        }
    </script>
</body>
</html>